---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Time from "../components/Time.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import LogoImage from "../assets/images/lofoten-jazzklubb.png";

const events = (await getCollection("event")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Image src={LogoImage} alt={SITE_TITLE} class="w-full mt-16" />
  <section>
    <ul>
      {
        events.map((event) => (
          <li>
            <a href={`/arrangement/${event.id}/`}>
              {event.data.heroImage && (
                <Image
                  width={720}
                  height={360}
                  src={event.data.heroImage}
                  alt={""}
                />
              )}
              <h4>{event.data.title}</h4>
              <p>
                <Time date={event.data.startDate} />
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
