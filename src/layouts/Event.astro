---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Time from "../components/Time.astro";
import Layout from "./Layout.astro";
import "../styles/global.css";
import { formatIso, formatWeekdayDateTime } from "../utils/date";

type Props = CollectionEntry<"event">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  startDate,
  endDate,
  venue,
  heroImage,
} = Astro.props;

// MusicEvent is what earns event rich results in Google Search — the date,
// venue and name are the fields it looks for.
const eventSchema = {
  "@type": "MusicEvent",
  name: title,
  description,
  // formatIso keeps the local offset (2026-09-12T20:00:00+02:00) rather than
  // normalising to UTC, so the advertised start time reads as the wall-clock
  // time at the venue.
  startDate: formatIso(startDate),
  ...(endDate ? { endDate: formatIso(endDate) } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: venue,
    address: { "@type": "PostalAddress", addressCountry: "NO" },
  },
  organizer: { "@id": new URL("#organization", Astro.site).href },
};
---

<Layout title={title} description={description}>
  <article class="space-y-8">
    <div>
      {heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
    </div>
    <div class="space-y-4">
      <h1>{title}</h1>
      <div class="grid grid-cols-[auto_1fr] gap-3 items-center">
        <Icon name="circum:calendar-date" size={40} />
        <span class="first-letter:uppercase"
          ><Time date={startDate} format={formatWeekdayDateTime} /></span
        >
        <Icon name="circum:location-on" size={40} />
        <span>{venue}</span>
      </div>
      <hr />
      <div class="flex items-baseline gap-1 text-gray-700">
        Publisert: <Time date={pubDate} />
        {
          updatedDate && (
            <div class="text-gray-500 text-xs">
              (oppdatert: <Time date={updatedDate} />)
            </div>
          )
        }
      </div>
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>
