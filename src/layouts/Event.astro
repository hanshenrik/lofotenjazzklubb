---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Authors from "../components/Authors.astro";
import Divider from "../components/Divider.astro";
import PublishDate from "../components/PublishDate.astro";
import Time from "../components/Time.astro";
import Layout from "./Layout.astro";
import "../styles/global.css";
import { formatIso, formatWeekdayDateTime } from "../utils/date";

type Props = CollectionEntry<"event">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  startDate,
  endDate,
  venue,
  heroImage,
  authors,
} = Astro.props;

// MusicEvent is what earns event rich results in Google Search — the date,
// venue and name are the fields it looks for.
const eventSchema = {
  "@type": "MusicEvent",
  name: title,
  description,
  // formatIso keeps the local offset (2026-09-12T20:00:00+02:00) rather than
  // normalising to UTC, so the advertised start time reads as the wall-clock
  // time at the venue.
  startDate: formatIso(startDate),
  ...(endDate ? { endDate: formatIso(endDate) } : {}),
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: venue,
    address: { "@type": "PostalAddress", addressCountry: "NO" },
  },
  organizer: { "@id": new URL("#organization", Astro.site).href },
};
---

<Layout title={title} description={description} image={heroImage}>
  <article class="space-y-8">
    <div>
      {
        heroImage && (
          <Image
            width={1020}
            height={510}
            src={heroImage}
            alt={title}
            loading="eager"
          />
        )
      }
    </div>
    <div class="space-y-4">
      <h1>{title}</h1>
      <div class="grid grid-cols-[auto_1fr] items-center gap-3">
        <Icon name="circum:calendar-date" size={40} class="-translate-y-0.5" />
        <span class="text-lg first-letter:uppercase md:text-xl"
          ><Time date={startDate} format={formatWeekdayDateTime} /></span
        >
        <Icon name="circum:location-on" size={40} class="-translate-y-0.5" />
        <span class="text-lg md:text-xl">{venue}</span>
      </div>
      <Divider variant="small-gray" />
      <div class="space-y-1">
        <Authors authors={authors} />
        <PublishDate pubDate={pubDate} updatedDate={updatedDate} />
      </div>
      <Divider variant="big-blue" />
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>
