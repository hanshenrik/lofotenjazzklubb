---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "../components/BaseHead.astro";

const { title, description } = Astro.props;

// Sticky footer: <body> is a full-height flex column and <main> is the only
// growing child, so a short page pushes the footer to the bottom of the
// viewport instead of leaving it floating mid-screen.
---

<!doctype html>
<html lang="nb">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
