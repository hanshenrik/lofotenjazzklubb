---
import type { ComponentProps } from "astro/types";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

// Transparent to BaseHead: the props are taken straight from it and forwarded
// untouched, so a page that needs a share image, article timestamps or extra
// JSON-LD can pass them here instead of hand-rolling its own <html>/<head>
// just to reach BaseHead. Add a prop to BaseHead and it is available here with
// no change to this file.
type Props = ComponentProps<typeof BaseHead>;

// Sticky footer: <body> is a full-height flex column and <main> is the only
// growing child, so a short page pushes the footer to the bottom of the
// viewport instead of leaving it floating mid-screen.
---

<!doctype html>
<html lang="nb" class="no-js">
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <Header />
    <main class="mx-auto w-full max-w-4xl flex-1 px-4 pt-16 pb-32">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Remove no-js class and add js class to html element
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");

      // Initialize typewriter animations
      document.addEventListener("DOMContentLoaded", function () {
        const typewriters = document.querySelectorAll(".typewriter-text");
        typewriters.forEach(function (container) {
          const fullText = container.dataset.text;
          let i = 0;

          function typeWriter() {
            if (i < fullText.length) {
              container.textContent = fullText.substring(0, i + 1);
              i++;
              setTimeout(typeWriter, 50);
            }
          }

          typeWriter();
        });
      });
    </script>
  </body>
</html>
