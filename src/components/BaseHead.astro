---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";

import {
  SITE_DESCRIPTION,
  SITE_LOCALE,
  SITE_TITLE,
  THEME_COLOR,
} from "../consts";

interface Props {
  title: string;
  description: string;
  /** Page-specific share image. Falls back to the generated site-wide one. */
  image?: ImageMetadata;
  /** `article` unlocks the published/modified metadata below. */
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Extra schema.org JSON-LD for this page, e.g. a MusicEvent. */
  schema?: Record<string, unknown>;
}

const {
  title,
  description,
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  schema,
} = Astro.props;

// No .ico among the icons below: every current browser accepts PNG, and the
// source artwork is raster so an SVG favicon would just wrap a bitmap.
// The robots directive sets max-image-preview:large, which opts the share image
// into full-size search previews.
//
// Every absolute URL is derived from Astro.site — set it in astro.config.mjs.
// Open Graph consumers reject relative URLs outright.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// A page image is re-rendered at OG dimensions rather than shipped at its
// source size: hero images can be many megabytes, and scrapers cap payloads.
// Both branches are exactly OG_WIDTH x OG_HEIGHT — the generated default from
// scripts/generate-favicons.mjs, and the getImage() call below — so the dimensions
// are stated directly. (getImage() returns width/height under `attributes`, not
// on the result itself, so reading result.width yields undefined.)
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogImageSrc = image
  ? (
      await getImage({
        src: image,
        width: OG_WIDTH,
        height: OG_HEIGHT,
        format: "png",
      })
    ).src
  : "/og-image.png";
const ogImageURL = new URL(ogImageSrc, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("#organization", Astro.site).href,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: Astro.site?.href,
      logo: new URL("/icon-512.png", Astro.site).href,
    },
    {
      "@type": "WebSite",
      "@id": new URL("#website", Astro.site).href,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      url: Astro.site?.href,
      inLanguage: SITE_LOCALE,
      publisher: { "@id": new URL("#organization", Astro.site).href },
    },
    ...(schema ? [schema] : []),
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Icons -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={THEME_COLOR} />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title} {title === SITE_TITLE ? "" : `| ${SITE_TITLE}`}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={SITE_LOCALE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={title} />
{
  type === "article" && publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  type === "article" && modifiedTime && (
    <meta
      property="article:modified_time"
      content={modifiedTime.toISOString()}
    />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured data -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
