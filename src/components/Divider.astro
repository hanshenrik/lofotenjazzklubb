---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"hr"> & {
  variant: "big-blue" | "small-gray";
};

const { variant, class: className } = Astro.props;
---

{
  variant === "big-blue" ? (
    <div class:list={["h-1.5 w-full -skew-x-12 bg-blue-500", className]} />
  ) : (
    <hr class:list={["w-24 border-t border-gray-300", className]} />
  )
}
