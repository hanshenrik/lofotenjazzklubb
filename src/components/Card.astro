---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * One entry in a listing — an event on the front page, a post under /aktuelt.
 * Renders its own <li>, so it belongs directly inside a <ul>.
 *
 * Only what both listings share lives here: the link, its hover outline, the
 * hero image and the title. Everything the two disagree on comes in through the
 * slots, because an event's metadata (venue, a date that can span days) has
 * nothing in common with a post's beyond sitting in the same place.
 *
 *   `meta`    — sits under the title, inside the same grid. Badges, dates.
 *   default   — below that, full width. A description, an ingress.
 *
 * Slotted markup lands inside the `.group` anchor, so `group-hover:` utilities
 * work from a call site exactly as they do here.
 */
interface Props {
  href: string;
  title: string;
  image?: ImageMetadata;
}

const { href, title, image } = Astro.props;
---

<li>
  <a
    href={href}
    class="no-hover-effect group block no-underline hover:outline-4 hover:outline-offset-16 hover:outline-blue-700"
  >
    {
      image && (
        <Image width={720} height={360} src={image} alt="" class="w-full" />
      )
    }
    <div class="space-y-2 pt-4 pb-2">
      <div class="grid grid-cols-1 items-center">
        <h4
          class="bg-blue-700 px-2 py-2 text-2xl text-white md:bg-transparent md:px-0 md:text-6xl md:text-black md:group-hover:bg-blue-700 md:group-hover:text-white"
        >
          {title}
        </h4>
        <slot name="meta" />
      </div>

      <slot />
    </div>
  </a>
</li>
