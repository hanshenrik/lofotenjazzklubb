---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

interface Props {
  authors?: string[];
  size?: "sm" | "md";
}

const { authors, size } = Astro.props;

// Load all authors once and filter by the provided file paths
const allAuthors = authors?.length ? await getCollection("authors") : [];
const validAuthors = allAuthors.filter((a) =>
  authors?.some((authorPath) => {
    // authorPath could be "src/content/authors/hans-henrik-gronsleth.mdx"
    // Extract just the filename without extension
    const parts = authorPath.split("/");
    const filenameWithExt = parts[parts.length - 1];
    const filename = filenameWithExt.replace(/\.(mdx|md)$/, "");
    return a.id === filename;
  }),
);
---

{
  validAuthors.length ? (
    <div class="grid grid-cols-[auto_1fr] items-center gap-2 text-base text-gray-700">
      {validAuthors.map((author, index) => (
        <>
          {author.data.image ? (
            <Image
              src={author.data.image}
              alt={author.data.name}
              class:list={["skew-x-6", size === "sm" ? "w-8" : "w-16"]}
            />
          ) : (
            <div class="h-10 w-10 skew-x-6 bg-blue-200" />
          )}
          <span>
            {index > 0 && ", "}
            {author.data.name}
          </span>
        </>
      ))}
    </div>
  ) : null
}
