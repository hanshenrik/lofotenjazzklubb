---
interface Author {
  name: string;
}

interface Props {
  authors?: Author[];
}

const { authors } = Astro.props;
---

{
  authors?.length ? (
    <div class="text-sm text-gray-600">
      Forfatter{authors.length > 1 ? "e" : ""}:
      {authors.map((author, index) => (
        <>
          {index > 0 && ", "}
          {author.name}
        </>
      ))}
    </div>
  ) : null
}
